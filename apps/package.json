{
  "name": "@ai-toolkit/apps",
  "version": "0.0.0",
  "private": true,
  "description": "AI TOOLKIT sites (docs, www, studio) — single workspace package",
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:docs": "node scripts/build-one.mjs docs",
    "build:www": "node scripts/build-one.mjs www",
    "build:studio": "node scripts/build-one.mjs studio",
    "dev": "node scripts/dev-all.mjs",
    "dev:docs": "node scripts/dev-one.mjs docs",
    "dev:www": "node scripts/dev-one.mjs www",
    "dev:studio": "node scripts/dev-one.mjs studio",
    "start": "node scripts/start-one.mjs all",
    "start:docs": "node scripts/start-one.mjs docs",
    "start:www": "node scripts/start-one.mjs www",
    "start:studio": "node scripts/start-one.mjs studio",
    "lint": "eslint \"./{docs,www,studio}/**/*.ts*\" --ignore-pattern \"*.tsbuildinfo\" --ignore-pattern \"**/.next/**\" --ignore-pattern \"**/dist/**\"",
    "type-check": "tsc -p www/tsconfig.json --noEmit && tsc -p studio/tsconfig.json --noEmit && tsc -p docs/tsconfig.json --noEmit",
    "clean": "del-cli docs/.next www/.next studio/.next docs/.source",
    "postinstall": "cd docs && fumadocs-mdx",
    "translate": "cd docs && geistdocs translate"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.134",
    "@vercel/geistdocs": "1.26.1",
    "@ai-toolkit/react": "workspace:*",
    "@ai-toolkit/design": "workspace:*",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@orama/tokenizers": "^3.1.16",
    "@streamdown/cjk": "^1.0.1",
    "@streamdown/code": "^1.0.1",
    "@vercel/agent-readability": "^0.7.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.132",
    "ai-toolkit": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "feed": "^5.1.0",
    "fumadocs-core": "16.2.2",
    "fumadocs-mdx": "14.0.4",
    "fumadocs-ui": "16.2.2",
    "geist": "^1.7.1",
    "jotai": "^2.15.2",
    "lucide-react": "^0.555.0",
    "mermaid": "^11.12.2",
    "motion": "^12.23.25",
    "nanoid": "^5.1.6",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "1.6.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-player": "^3.4.0",
    "shiki": "3.19.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "use-stick-to-bottom": "^1.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@shikijs/transformers": "^3.9.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "del-cli": "^6.0.0",
    "eslint": "8.57.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
