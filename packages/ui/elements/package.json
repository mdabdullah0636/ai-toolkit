{
  "name": "@ai-toolkit/elements",
  "version": "0.2.0",
  "description": "AI TOOLKIT Elements - React components for AI-native applications (shadcn-ready)",
  "license": "Apache-2.0",
  "sideEffects": false,
  "stability": "beta",
  "owners": [
    "@khulnasoft/ai-react-team"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "files": [
    "dist/**/*",
    "registry.json",
    "registry/**/*",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsup --tsconfig tsconfig.build.json",
    "build:watch": "pnpm clean && tsup --watch",
    "clean": "del-cli dist *.tsbuildinfo",
    "lint": "eslint \"./**/*.ts*\"",
    "type-check": "tsc --build",
    "prettier-check": "prettier --check \"./**/*.ts*\"",
    "test": "vitest --config vitest.config.js --run",
    "test:update": "vitest --config vitest.config.js --run -u",
    "test:watch": "vitest --config vitest.config.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  },
  "dependencies": {
    "@ai-toolkit/shadcn-ui": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.26.1",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xyflow/react": "^12.10.0",
    "ai-toolkit": "workspace:*",
    "ansi-to-react": "^6.2.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "media-chrome": "^4.17.2",
    "motion": "^12.26.2",
    "nanoid": "^5.1.6",
    "react-jsx-parser": "^2.2.0",
    "shiki": "3.22.0",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^2.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.3"
  },
  "peerDependencies": {
    "react": "^18 || ~19.0.1 || ~19.1.2 || ^19.2.1",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@khulnasoft/ai-tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "20.17.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.3.3",
    "del-cli": "^6.0.0",
    "eslint": "8.57.1",
    "eslint-config-khulnasoft-ai": "workspace:*",
    "jsdom": "^24.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^7.2.0",
    "typescript": "5.8.3",
    "zod": "^4.1.11"
  }
}
