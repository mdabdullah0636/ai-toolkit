{
  "name": "@ai-toolkit/capabilities",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "sideEffects": false,
  "stability": "beta",
  "owners": [
    "@ai-toolkit/core"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "source": "./src/index.ts",
  "files": [
    "dist/**/*",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsup --tsconfig tsconfig.build.json",
    "clean": "del-cli dist *.tsbuildinfo",
    "lint": "eslint \"./**/*.ts*\"",
    "type-check": "tsc --build",
    "prettier-check": "prettier --check \"./**/*.ts*\""
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ai-toolkit/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.17.24",
    "@khulnasoft/ai-tsconfig": "workspace:*",
    "del-cli": "^5.1.0",
    "tsup": "^8",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
