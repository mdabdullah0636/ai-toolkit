{
  "name": "@ai-toolkit/codemod",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "sideEffects": false,
  "stability": "stable",
  "owners": [
    "@khulnasoft/developer-tools-team"
  ],
  "source": "./src/bin/codemod.ts",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm generate-readme && prettier --write \"README.md\" && pnpm clean && tsup --tsconfig tsconfig.build.json",
    "clean": "del-cli dist *.tsbuildinfo",
    "dev": "tsup --watch",
    "lint": "eslint \"./**/*.ts*\"",
    "type-check": "tsc --build",
    "prettier-check": "prettier --check \"./**/*.ts*\"",
    "test": "vitest --config vitest.config.ts --run",
    "test:watch": "vitest",
    "test:update": "UPDATE_SNAPSHOT=true vitest -u --run",
    "scaffold": "tsx scripts/scaffold-codemod.ts",
    "generate-readme": "tsx scripts/generate-readme.ts"
  },
  "devDependencies": {
    "@ai-toolkit/ai": "workspace:*",
    "@types/cli-progress": "^3.11.6",
    "@types/debug": "^4.1.12",
    "@types/jscodeshift": "^0.12.0",
    "@types/node": "20.17.24",
    "@types/semver": "^7.5.8",
    "@khulnasoft/ai-tsconfig": "workspace:*",
    "msw": "2.6.4",
    "tsup": "^8",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "5.0.1"
  },
  "bin": {
    "codemod": "./dist/bin/codemod.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://studio.khulnasoft.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khulnasoft/ai-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/khulnasoft/ai-toolkit/issues"
  },
  "keywords": [
    "ai"
  ],
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "debug": "^4.4.3",
    "jscodeshift": "^17.1.1"
  }
}
