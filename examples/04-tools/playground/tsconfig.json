{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "es6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"],
  "references": [
    {
      "path": "../../../packages/adapters/react"
    },
    {
      "path": "../../../packages/core/ai-toolkit"
    },
    {
      "path": "../../../packages/core/provider-utils"
    },
    {
      "path": "../../../packages/providers/anthropic"
    },
    {
      "path": "../../../packages/providers/azure"
    },
    {
      "path": "../../../packages/providers/cohere"
    },
    {
      "path": "../../../packages/providers/deepseek"
    },
    {
      "path": "../../../packages/providers/fireworks"
    },
    {
      "path": "../../../packages/providers/google"
    },
    {
      "path": "../../../packages/providers/google-vertex"
    },
    {
      "path": "../../../packages/providers/groq"
    },
    {
      "path": "../../../packages/providers/mistral"
    },
    {
      "path": "../../../packages/providers/openai"
    },
    {
      "path": "../../../packages/providers/perplexity"
    },
    {
      "path": "../../../packages/providers/xai"
    },
    {
      "path": "../../../packages/validation/provider"
    }
  ]
}
